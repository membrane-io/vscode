		"peekViewEditor.matchHighlightBackground": "#ff800066",
		"peekViewResult.background": "#efefef",
		"peekViewResult.matchHighlightBackground": "#ff800066",
		"pickerGroup.border": "#bbb",
		"pickerGroup.foreground": "#bbb",
		"ports.iconRunningProcessForeground": "#369432",
		"progressBar.background": "#ff8000",
		"quickInput.background": "#efefef",
		"quickInput.foreground": "#3c3c3c",
		"scrollbarSlider.background": "#66666658",
		"scrollbarSlider.hoverBackground": "#6666669b",
		"scrollbarSlider.activeBackground": "#666666ff",
		"scrollbar.shadow": "#00000040",
		"searchEditor.textInputBorder": "#bbb",
		"settings.dropdownBackground": "#efefef",
