	"tokenColors": [
		{
			"name": "Comment",
			"scope": [
				"comment",
				"punctuation.definition.comment"
			],
			"settings": {
				"foreground": "#6b6b6b",
				"fontStyle": "italic"
			}
		},
		{
			"name": "String",
			"scope": [
				"string"
			],
			"settings": {
				"foreground": "#4a7300",
				"fontStyle": "italic"
			}
		},
		{
			"name": "String Regex",
			"scope": [
				"string.regexp"
			],
			"settings": {
				"foreground": "#ad5200",
				"fontStyle": ""
			}
		},
		{
			"name": "String Escape",
			"scope": [
				"constant.character.escape"
			],
			"settings": {
				"foreground": "#ad5200"
			}
		},
		{
			"name": "Number",
			"scope": [
				"constant.numeric"
			],
			"settings": {
				"foreground": "#ad5200"
			}
		},
		{
			"name": "Constant",
			"scope": [
				"constant.language",
				"constant.other"
			],
			"settings": {
				"foreground": "#ad5200"
			}
		},
		{
			"name": "Boolean",
			"scope": [
				"constant.language.boolean"
			],
			"settings": {
				"foreground": "#4a7300"
			}
		},
		{
			"name": "Keyword / Storage",
			"scope": [
				"keyword",
				"storage",
				"storage.type"
			],
			"settings": {
				"foreground": "#ad5200"
			}
		},
		{
			"name": "Variable",
			"scope": [
				"variable"
			],
			"settings": {
				"foreground": "#2b2b2b"
			}
		},
		{
			"name": "Variable Special (this, self, super)",
			"scope": [
				"variable.language",
				"variable.parameter.function"
			],
			"settings": {
				"foreground": "#ad5200"
			}
		},
		{
			"name": "Function",
			"scope": [
				"entity.name.function",
				"support.function",
				"meta.function-call entity.name.function"
			],
			"settings": {
				"foreground": "#111111",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Constructor / Class Name",
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"support.class"
			],
			"settings": {
				"foreground": "#111111",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Tag",
			"scope": [
				"entity.name.tag",
				"meta.tag"
			],
			"settings": {
				"foreground": "#5a6680"
			}
		},
		{
			"name": "Attribute",
			"scope": [
				"entity.other.attribute-name"
			],
			"settings": {
				"foreground": "#4a7300"
			}
		},
		{
			"name": "Property",
			"scope": [
				"support.type.property-name",
				"variable.other.property",
				"variable.other.object.property"
			],
			"settings": {
				"foreground": "#4a7300"
			}
		},
		{
			"name": "Operator",
			"scope": [
				"keyword.operator"
			],
			"settings": {
				"foreground": "#5a6680"
			}
		},
		{
			"name": "Punctuation",
			"scope": [
				"punctuation",
				"meta.brace"
			],
			"settings": {
				"foreground": "#5a6680"
			}
		},
		{
			"name": "Punctuation Delimiter",
			"scope": [
				"punctuation.separator",
				"punctuation.terminator"
			],
			"settings": {
				"foreground": "#5a6680"
			}
		},
		{
			"name": "Enum / Type Builtin",
			"scope": [
				"support.type",
				"support.type.builtin"
			],
			"settings": {
				"foreground": "#5a6680"
			}
		},
		{
			"name": "Link URI",
			"scope": [
				"markup.underline.link"
			],
			"settings": {
				"foreground": "#4a7300",
				"fontStyle": "italic"
			}
		},
		{
			"name": "Markup Heading",
			"scope": [
				"markup.heading",
				"entity.name.section"
			],
			"settings": {
				"foreground": "#111111",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Markup Bold",
			"scope": [
				"markup.bold"
			],
			"settings": {
				"fontStyle": "bold"
			}
		},
		{
			"name": "Markup Italic",
			"scope": [
				"markup.italic"
			],
			"settings": {
				"fontStyle": "italic"
			}
		},
		{
			"name": "Markup Inline Code",
			"scope": [
				"markup.inline.raw",
				"markup.raw"
			],
			"settings": {
				"foreground": "#2b2b2b"
			}
		},
		{
			"name": "Variant / Enum Member",
			"scope": [
				"variable.other.enummember",
				"constant.other.enum"
			],
			"settings": {
				"foreground": "#ad5200"
			}
		}
	],
	"semanticHighlighting": false
}
