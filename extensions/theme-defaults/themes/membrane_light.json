		"editorBracketHighlight.foreground1": "#5a6680",
		"editorBracketHighlight.foreground2": "#5a6680",
		"editorBracketHighlight.foreground3": "#5a6680",
		"editorBracketHighlight.foreground4": "#5a6680",
		"editorBracketHighlight.foreground5": "#5a6680",
		"editorBracketHighlight.foreground6": "#5a6680"
