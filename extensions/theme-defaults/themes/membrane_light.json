		"toolbar.hoverBackground": "#ddd",
		"keybindingLabel.foreground": "#3c3c3c",
		"list.activeSelectionBackground": "#ddd",
		"list.activeSelectionForeground": "#000",
		"list.activeSelectionIconForeground": "#000",
		"list.hoverBackground": "#d1d1d1",
		"menu.background": "#f8f8f8",
		"list.focusAndSelectionOutline": "#3c3c3c",
		"menu.border": "#bbb",
		"notebook.cellBorderColor": "#bbb",
		"notebook.selectedCellBackground": "#eeeeee50",
		"notificationCenterHeader.background": "#efefef",
