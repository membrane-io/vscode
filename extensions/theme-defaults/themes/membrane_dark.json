	"tokenColors": [
		{
			"name": "Comment",
			"scope": [
				"comment",
				"punctuation.definition.comment"
			],
			"settings": {
				"foreground": "#858585",
				"fontStyle": "italic"
			}
		},
		{
			"name": "String",
			"scope": [
				"string"
			],
			"settings": {
				"foreground": "#b1d631",
				"fontStyle": "italic"
			}
		},
		{
			"name": "String Regex",
			"scope": [
				"string.regexp"
			],
			"settings": {
				"foreground": "#ff9800",
				"fontStyle": ""
			}
		},
		{
			"name": "String Escape",
			"scope": [
				"constant.character.escape"
			],
			"settings": {
				"foreground": "#ff9800"
			}
		},
		{
			"name": "Number",
			"scope": [
				"constant.numeric"
			],
			"settings": {
				"foreground": "#ff9800"
			}
		},
		{
			"name": "Constant",
			"scope": [
				"constant.language",
				"constant.other"
			],
			"settings": {
				"foreground": "#ff9800"
			}
		},
		{
			"name": "Boolean",
			"scope": [
				"constant.language.boolean"
			],
			"settings": {
				"foreground": "#b1d631"
			}
		},
		{
			"name": "Keyword / Storage",
			"scope": [
				"keyword",
				"storage",
				"storage.type"
			],
			"settings": {
				"foreground": "#ff9800"
			}
		},
		{
			"name": "Variable",
			"scope": [
				"variable"
			],
			"settings": {
				"foreground": "#e2e2e5"
			}
		},
		{
			"name": "Variable Special (this, self, super)",
			"scope": [
				"variable.language",
				"variable.parameter.function"
			],
			"settings": {
				"foreground": "#ff9800"
			}
		},
		{
			"name": "Function",
			"scope": [
				"entity.name.function",
				"support.function",
				"meta.function-call entity.name.function"
			],
			"settings": {
				"foreground": "#ffffff",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Constructor / Class Name",
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"support.class"
			],
			"settings": {
				"foreground": "#ffffff",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Tag",
			"scope": [
				"entity.name.tag",
				"meta.tag"
			],
			"settings": {
				"foreground": "#7e8aa2"
			}
		},
		{
			"name": "Attribute",
			"scope": [
				"entity.other.attribute-name"
			],
			"settings": {
				"foreground": "#b1d631"
			}
		},
		{
			"name": "Property",
			"scope": [
				"support.type.property-name",
				"variable.other.property",
				"variable.other.object.property"
			],
			"settings": {
				"foreground": "#b1d631"
			}
		},
		{
			"name": "Operator",
			"scope": [
				"keyword.operator"
			],
			"settings": {
				"foreground": "#7e8aa2"
			}
		},
		{
			"name": "Punctuation",
			"scope": [
				"punctuation",
				"meta.brace"
			],
			"settings": {
				"foreground": "#7e8aa2"
			}
		},
		{
			"name": "Punctuation Delimiter",
			"scope": [
				"punctuation.separator",
				"punctuation.terminator"
			],
			"settings": {
				"foreground": "#7e8aa2"
			}
		},
		{
			"name": "Enum / Type Builtin",
			"scope": [
				"support.type",
				"support.type.builtin"
			],
			"settings": {
				"foreground": "#7e8aa2"
			}
		},
		{
			"name": "Link URI",
			"scope": [
				"markup.underline.link"
			],
			"settings": {
				"foreground": "#b1d631",
				"fontStyle": "italic"
			}
		},
		{
			"name": "Markup Heading",
			"scope": [
				"markup.heading",
				"entity.name.section"
			],
			"settings": {
				"foreground": "#ffffff",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Markup Bold",
			"scope": [
				"markup.bold"
			],
			"settings": {
				"fontStyle": "bold"
			}
		},
		{
			"name": "Markup Italic",
			"scope": [
				"markup.italic"
			],
			"settings": {
				"fontStyle": "italic"
			}
		},
		{
			"name": "Markup Inline Code",
			"scope": [
				"markup.inline.raw",
				"markup.raw"
			],
			"settings": {
				"foreground": "#e2e2e5"
			}
		},
		{
			"name": "Variant / Enum Member",
			"scope": [
				"variable.other.enummember",
				"constant.other.enum"
			],
			"settings": {
				"foreground": "#ff9800"
			}
		}
	],
	"semanticHighlighting": false
}
