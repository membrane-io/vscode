{
	"$schema": "vscode://schemas/color-theme",
	"name": "Membrane Light Dim",
	"include": "./membrane_light.json",
	"tokenColors": [
		{
			"name": "Comment",
			"scope": [
				"comment",
				"punctuation.definition.comment"
			],
			"settings": {
				"foreground": "#d4d4d4",
				"fontStyle": "italic"
			}
		},
		{
			"name": "String",
			"scope": [
				"string"
			],
			"settings": {
				"foreground": "#2f4800",
				"fontStyle": "italic"
			}
		},
		{
			"name": "String Regex",
			"scope": [
				"string.regexp"
			],
			"settings": {
				"foreground": "#6a3200",
				"fontStyle": ""
			}
		},
		{
			"name": "String Escape",
			"scope": [
				"constant.character.escape"
			],
			"settings": {
				"foreground": "#6a3200"
			}
		},
		{
			"name": "Number",
			"scope": [
				"constant.numeric"
			],
			"settings": {
				"foreground": "#6a3200"
			}
		},
		{
			"name": "Constant",
			"scope": [
				"constant.language",
				"constant.other"
			],
			"settings": {
				"foreground": "#6a3200"
			}
		},
		{
			"name": "Boolean",
			"scope": [
				"constant.language.boolean"
			],
			"settings": {
				"foreground": "#2f4800"
			}
		},
		{
			"name": "Keyword / Storage",
			"scope": [
				"keyword",
				"storage",
				"storage.type"
			],
			"settings": {
				"foreground": "#6a3200"
			}
		},
		{
			"name": "Variable",
			"scope": [
				"variable"
			],
			"settings": {
				"foreground": "#2b2b2b"
			}
		},
		{
			"name": "Variable Special (this, self, super)",
			"scope": [
				"variable.language",
				"variable.parameter.function"
			],
			"settings": {
				"foreground": "#6a3200"
			}
		},
		{
			"name": "Function",
			"scope": [
				"entity.name.function",
				"support.function",
				"meta.function-call entity.name.function"
			],
			"settings": {
				"foreground": "#111111",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Constructor / Class Name",
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"support.class"
			],
			"settings": {
				"foreground": "#111111",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Tag",
			"scope": [
				"entity.name.tag",
				"meta.tag"
			],
			"settings": {
				"foreground": "#3a4152"
			}
		},
		{
			"name": "Attribute",
			"scope": [
				"entity.other.attribute-name"
			],
			"settings": {
				"foreground": "#2f4800"
			}
		},
		{
			"name": "Property",
			"scope": [
				"support.type.property-name",
				"variable.other.property",
				"variable.other.object.property"
			],
			"settings": {
				"foreground": "#2f4800"
			}
		},
		{
			"name": "Operator",
			"scope": [
				"keyword.operator"
			],
			"settings": {
				"foreground": "#3a4152"
			}
		},
		{
			"name": "Punctuation",
			"scope": [
				"punctuation",
				"meta.brace"
			],
			"settings": {
				"foreground": "#3a4152"
			}
		},
		{
			"name": "Punctuation Delimiter",
			"scope": [
				"punctuation.separator",
				"punctuation.terminator"
			],
			"settings": {
				"foreground": "#3a4152"
			}
		},
		{
			"name": "Enum / Type Builtin",
			"scope": [
				"support.type",
				"support.type.builtin"
			],
			"settings": {
				"foreground": "#3a4152"
			}
		},
		{
			"name": "Link URI",
			"scope": [
				"markup.underline.link"
			],
			"settings": {
				"foreground": "#2f4800",
				"fontStyle": "italic"
			}
		},
		{
			"name": "Markup Heading",
			"scope": [
				"markup.heading",
				"entity.name.section"
			],
			"settings": {
				"foreground": "#111111",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Markup Bold",
			"scope": [
				"markup.bold"
			],
			"settings": {
				"fontStyle": "bold"
			}
		},
		{
			"name": "Markup Italic",
			"scope": [
				"markup.italic"
			],
			"settings": {
				"fontStyle": "italic"
			}
		},
		{
			"name": "Markup Inline Code",
			"scope": [
				"markup.inline.raw",
				"markup.raw"
			],
			"settings": {
				"foreground": "#2b2b2b"
			}
		},
		{
			"name": "Variant / Enum Member",
			"scope": [
				"variable.other.enummember",
				"constant.other.enum"
			],
			"settings": {
				"foreground": "#6a3200"
			}
		}
	],
	"semanticHighlighting": false,
	"colors": {
		"editorBracketHighlight.foreground1": "#3a4152",
		"editorBracketHighlight.foreground2": "#3a4152",
		"editorBracketHighlight.foreground3": "#3a4152",
		"editorBracketHighlight.foreground4": "#3a4152",
		"editorBracketHighlight.foreground5": "#3a4152",
		"editorBracketHighlight.foreground6": "#3a4152"
	}
}
